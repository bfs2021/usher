{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python3 -m unittest discover *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)"
    ],
    "deny": [
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_guard.py\""
          }
        ]
      }
    ]
  }
}
